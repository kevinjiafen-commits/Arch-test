    self._lastTargetWorld = nil
    self._shootLock._lockedUntil = nil
    if self._charCtrl then
        self._charCtrl:SetServerCFrame(nil)
        self._charCtrl:SendViewAngles(20, nil)
        self._charCtrl:HeartbeatUpdate()
    end
