    end
    for i, p in ipairs(priorityQueue) do
        Create("TextLabel", {
            Parent           = queueList,
            Size             = UDim2.new(1, 0, 0, 20),
            BackgroundColor3 = i == 1 and CFG.SecondaryColor or CFG.MainColor,
            BorderSizePixel  = 0,
            TextColor3       = i == 1 and CFG.AccentColor or CFG.TextDark,
            Font             = CFG.Font,
            TextSize         = 11,
            TextXAlignment   = Enum.TextXAlignment.Left,
            Text             = string.format("  %d  %s%s", i, p.Name, i == 1 and "  ◀" or ""),
        }, { Create("UICorner", { CornerRadius = UDim.new(0, 2) }) })
    end
end

refreshPlayerList = function()
    for _, c in ipairs(playerList:GetChildren()) do
        if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local idx = qIdx(p)
            local btn = Create("TextButton", {
                Parent           = playerList,
                Size             = UDim2.new(1, 0, 0, 22),
                BackgroundColor3 = idx and CFG.SecondaryColor or CFG.MainColor,
                BorderSizePixel  = 0,
                TextColor3       = idx and CFG.AccentColor or CFG.TextDark,
                Font             = CFG.Font,
                TextSize         = 11,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Text             = idx
                    and string.format("  [%d]  %s", idx, p.Name)
                    or  ("       " .. p.Name),
            }, { Create("UICorner", { CornerRadius = UDim.new(0, 2) }) })

            btn.MouseButton1Click:Connect(function()
                local ei = qIdx(p)
                if ei then
                    table.remove(priorityQueue, ei)
                    if targetPlayer == p then
                        if #priorityQueue > 0 then
                            targetPlayer = priorityQueue[1]
                            armDeathWatch(targetPlayer)          -- re-arm on manual switch
                            updateDeathWatchLabel()
                            setStatus("removed · now → " .. targetPlayer.Name)
                            Notify("now → " .. targetPlayer.Name)
                        else
                            targetPlayer = nil
                            stopFollow(); setFollowBtnState(false)
                            armDeathWatch(nil)
                            updateDeathWatchLabel()
                            setStatus("queue empty")
                            Notify("queue empty", "warning")
                        end
                    end
                else
                    table.insert(priorityQueue, p)
                    Notify("queued → " .. p.Name, "success")
                end
                refreshQueueDisplay(); refreshPlayerList()
                if #priorityQueue > 0 then
                    local qs = #priorityQueue == 1 and "1 target"
                           or  (#priorityQueue .. " queued")
                    setStatus("→ " .. priorityQueue[1].Name .. "  (" .. qs .. ")")
                end
            end)
        end
    end
end

setFollowBtnState = function(active)
    if active then
        followBtn.Text             = "⏹  STOP"
        followBtn.BackgroundColor3 = CFG.DangerColor
        followBtn.TextColor3       = Color3.new(1, 1, 1)
    else
        followBtn.Text             = "▶  FOLLOW"
        followBtn.BackgroundColor3 = CFG.AccentColor
        followBtn.TextColor3       = Color3.new(0, 0, 0)
    end
end

setStatus = function(text) statusLbl.Text = text end

-- ══ EVENTS ═══════════════════════════════════════════════════════════════════
refreshQueueDisplay(); refreshPlayerList()

if #priorityQueue > 0 then
    targetPlayer = priorityQueue[1]
    armDeathWatch(targetPlayer)          -- restore death-watch on queue restore
    updateDeathWatchLabel()
    setStatus(string.format(
        "queue restored · %d target(s) · press FOLLOW to resume",
        #priorityQueue))
    Notify(string.format("queue restored: %d target(s)", #priorityQueue), "success")
end

Players.PlayerAdded:Connect(function()
    task.wait(0.5); refreshPlayerList()
end)

Players.PlayerRemoving:Connect(function(p)
    local idx = qIdx(p)
    if idx then
        table.remove(priorityQueue, idx)
        if idx == 1 then
            if #priorityQueue > 0 then
                targetPlayer = priorityQueue[1]
                armDeathWatch(targetPlayer)
                updateDeathWatchLabel()
                setStatus("target left · now → " .. targetPlayer.Name)
                Notify("target left · now → " .. targetPlayer.Name, "warning")
            else
                targetPlayer = nil
                stopFollow(); setFollowBtnState(false)
                armDeathWatch(nil)
                updateDeathWatchLabel()
                setStatus("queue empty · player left")
                Notify("queue empty · player left", "warning")
            end
        else
            setStatus(#priorityQueue > 0
                and ("→ " .. priorityQueue[1].Name)
                or  "queue empty · player left")
        end
        refreshQueueDisplay()
    end
    task.delay(0.2, refreshPlayerList)
end)

-- re-arm Heartbeat connection after local respawn
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if following and targetPlayer then
        startFollow()
        setStatus("respawned · resuming → " .. targetPlayer.Name)
        Notify("respawned · resuming → " .. targetPlayer.Name, "success")
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    stopFollow()
    armDeathWatch(nil)
    ScreenGui:Destroy()
end)

followBtn.MouseButton1Click:Connect(function()
    if #priorityQueue == 0 then
        setStatus("add players to queue first")
        Notify("add players to queue first", "warning")
        return
    end
    if following then
        stopFollow(); setFollowBtnState(false)
        Notify("follow stopped", "warning")
    else
        targetPlayer = priorityQueue[1]
        startFollow(); setFollowBtnState(true)
        armDeathWatch(targetPlayer)      -- arm death-watch on follow start
        updateDeathWatchLabel()
        setStatus("following → " .. targetPlayer.Name)
        Notify("following → " .. targetPlayer.Name, "success")
    end
end)

tpBtn.MouseButton1Click:Connect(function()
    if #priorityQueue == 0 then
        setStatus("add players to queue first")
        Notify("add players to queue first", "warning")
        return
    end
    targetPlayer = priorityQueue[1]; teleportNow()
    setStatus("teleported → " .. targetPlayer.Name)
    Notify("teleported → " .. targetPlayer.Name, "success")
end)

clearBtn.MouseButton1Click:Connect(function()
    stopFollow()
    armDeathWatch(nil)
    updateDeathWatchLabel()
    for i = #priorityQueue, 1, -1 do table.remove(priorityQueue, i) end
    targetPlayer = nil
    setFollowBtnState(false)
    refreshQueueDisplay(); refreshPlayerList()
    setStatus("queue cleared")
    Notify("queue cleared", "warning")
end)

