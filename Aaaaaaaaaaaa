-- ══ HELPERS ══════════════════════════════════════════════════════════════════
local function getRoot(p)
    local c = p and p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function qIdx(p)
    for i, v in ipairs(priorityQueue) do
        if v == p then return i end
    end
end

-- ══ FOLLOW / TELEPORT ════════════════════════════════════════════════════════
local function stopFollow()
    following = false
    if followConn then followConn:Disconnect(); followConn = nil end
end

local function startFollow()
    if followConn then followConn:Disconnect() end
    following = true
    followConn = RunService.Heartbeat:Connect(function()
        if not following or not targetPlayer then return end
        local tr, lr = getRoot(targetPlayer), getRoot(LocalPlayer)
        if tr and lr then
            lr.CFrame = tr.CFrame * CFrame.new(off.x, off.y, off.z)
        end
    end)
end

local function teleportNow()
    if not targetPlayer then return end
    local tr, lr = getRoot(targetPlayer), getRoot(LocalPlayer)
    if tr and lr then lr.CFrame = tr.CFrame * CFrame.new(off.x, off.y, off.z) end
end

-- ══ DEATH WATCH (new) ════════════════════════════════════════════════════════
local armDeathWatch  -- forward-declare so the callback can reference it

local function onTargetDied()
    -- rotate dead player to tail of queue so they re-enter when alive again
    if #priorityQueue > 0 and priorityQueue[1] == targetPlayer then
        local dead = table.remove(priorityQueue, 1)
        table.insert(priorityQueue, dead)
    end

    refreshQueueDisplay()
    refreshPlayerList()

    if #priorityQueue == 0 or priorityQueue[1] == targetPlayer then
        -- only one target — no live replacement available
        stopFollow()
        setFollowBtnState(false)
        setStatus("target died · no next target")
        -- Notify defined later; call via pcall so the forward-ref is fine
        pcall(function() Notify("target died · queue exhausted", "warning") end)
        return
    end

    -- advance to next player
    targetPlayer = priorityQueue[1]
    if following then startFollow() end
    armDeathWatch(targetPlayer)

    setStatus("target died · now → " .. targetPlayer.Name)
    pcall(function() Notify("target died · now → " .. targetPlayer.Name, "warning") end)
end

armDeathWatch = function(player)
    -- drop previous death-watch
    if deathConn then deathConn:Disconnect(); deathConn = nil end
    if not player then return end

    local function connectHumanoid(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
                 or char:WaitForChild("Humanoid", 3)
        if not hum then return end
        -- guard: already dead on connect (edge case in fast respawn servers)
        if hum.Health <= 0 then task.defer(onTargetDied); return end
        deathConn = hum.Died:Connect(onTargetDied)
    end

    -- arm immediately if character exists
    connectHumanoid(player.Character)

    -- re-arm whenever target gets a new character (they respawned into queue tail)
    player.CharacterAdded:Connect(function(char)
        if player == targetPlayer then
            connectHumanoid(char)
        end
    end)
end

