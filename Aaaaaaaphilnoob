-- Build label index from all TextLabels in ScreenGui
-- We find them by walking the screen after a tick
task.defer(function()
	local function findLabels(inst, depth)
		if depth > 8 then return end
		for _, c in ipairs(inst:GetChildren()) do
			if c:IsA("TextLabel") then
				local keys = {"CharacterLabel","PositionLabel","VelocityLabel","SessionLabel","ModeLabel","PatternLabel",
					"HomeStateLabel","MotionStateLabel","SystemsStateLabel","PlayerStateLabel","GraphicsStateLabel",
					"PlayerCountLabel","NearestPlayerLabel"}
				for _, k in ipairs(keys) do
					if not Labels[k] and string.find(c.Text, k:gsub("Label",""):lower(), 1, true) == nil then end
					-- Match by initial text prefix
					if not Labels[k] then
						local prefix = tostring(k):gsub("Label$",""):lower()
						local txt = c.Text:lower()
						if txt:find(prefix, 1, true) or txt == "" then
							-- skip empties
						end
					end
				end
				-- Simpler: assign in order of creation
			end
			findLabels(c, depth+1)
		end
	end

	-- Collect all TextLabel children of Content frames in order
	local allLabels = {}
	local function collectLabels(inst, depth)
		if depth > 10 then return end
		for _, c in ipairs(inst:GetChildren()) do
			if c:IsA("TextLabel") and c.Text ~= "" then
				table.insert(allLabels, c)
			end
			collectLabels(c, depth+1)
		end
	end
	collectLabels(ScreenGui, 0)

	local keyOrder = {
		"CharacterLabel","PositionLabel","VelocityLabel","SessionLabel","ModeLabel","PatternLabel",
		"HomeStateLabel","MotionStateLabel","SystemsStateLabel","PlayerStateLabel","GraphicsStateLabel",
		"PlayerCountLabel","NearestPlayerLabel"
	}
	-- Assign by finding labels whose text starts with the expected default text
	local defaults = {
		CharacterLabel    = "Character:",
		PositionLabel     = "Position:",
		VelocityLabel     = "Velocity:",
		SessionLabel      = "Session:",
		ModeLabel         = "Mode:",
		PatternLabel      = "Pattern:",
		HomeStateLabel    = "Anchor:",
		MotionStateLabel  = "Motion:",
		SystemsStateLabel = "Systems:",
		PlayerStateLabel  = "Player:",
		GraphicsStateLabel= "Graphics:",
		PlayerCountLabel  = "Minimap:",
		NearestPlayerLabel= "Nearest:",
	}
	for _, lbl in ipairs(allLabels) do
		for key, prefix in pairs(defaults) do
			if not Labels[key] and lbl.Text:sub(1, #prefix) == prefix then
				Labels[key] = lbl
				break
			end
		end
	end
end)

-- ── Minimap helpers
local function stateText(v) return v and "on" or "off" end

local function getMinimapDot(targetPlayer)
	local dot = minimapDots[targetPlayer]
	if dot and dot.Parent then return dot end
	dot = Instance.new("Frame")
	dot.Name = targetPlayer.Name
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Size = UDim2.fromOffset(7, 7)
	dot.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
	dot.BorderSizePixel = 0
	dot.Visible = false
	dot.ZIndex = 5
	dot.Parent = minimapArea
	local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(1,0); dc.Parent = dot
	local dl = Instance.new("TextLabel")
	dl.Name = "Label"; dl.BackgroundTransparency = 1
	dl.Position = UDim2.fromOffset(9, -5); dl.Size = UDim2.fromOffset(120, 16)
	dl.Text = targetPlayer.Name; dl.TextColor3 = Color3.fromRGB(220, 220, 230)
	dl.Font = Enum.Font.Code; dl.TextSize = 10; dl.TextXAlignment = Enum.TextXAlignment.Left
	dl.Visible = minimapShowNames; dl.Parent = dot
	minimapDots[targetPlayer] = dot
	return dot
end

local function updateVoidMinimap()
	local areaSize = minimapArea.AbsoluteSize
	if areaSize.X <= 0 or areaSize.Y <= 0 then return end
	if not hrp then
		minimapStatus.Text = "Waiting for character root"
		minimapVisibleCount=0; minimapTrackedCount=0; minimapNearestText="Nearest: waiting"
		for _, dot in pairs(minimapDots) do dot.Visible=false end
		return
	end
	local center = Vector2.new(areaSize.X*0.5, areaSize.Y*0.5)
	local radius = math.max(1, math.min(areaSize.X, areaSize.Y)*0.5 - 8)
	local visibleCount=0; local seen={}; local entries={}
	local farthestDistance=0; local nearestName=nil; local nearestDistance=math.huge
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			seen[other]=true
			local otherChar=other.Character
			local otherRoot=otherChar and otherChar:FindFirstChild("HumanoidRootPart")
			local otherHum=otherChar and otherChar:FindFirstChildOfClass("Humanoid")
			local dot=getMinimapDot(other)
			if otherRoot and otherHum and otherHum.Health>0 then
				local relative=otherRoot.Position-hrp.Position
				local planarDistance=Vector3.new(relative.X,0,relative.Z).Magnitude
				table.insert(entries, {Player=other, Dot=dot, Relative=relative, Distance=planarDistance})
				farthestDistance=math.max(farthestDistance, planarDistance)
				if planarDistance<nearestDistance then nearestDistance=planarDistance; nearestName=other.Name end
			else dot.Visible=false end
		end
	end
	minimapRange=math.max(1000, farthestDistance*1.15)
	for _, entry in ipairs(entries) do
		local relative=entry.Relative; local planarDistance=entry.Distance; local dot=entry.Dot
		local mapRelative=Vector2.new(relative.X, relative.Z)
		if minimapRotateWithCamera and workspace.CurrentCamera then
			local look=workspace.CurrentCamera.CFrame.LookVector
			local yaw=math.atan2(look.X, look.Z)
			local cosYaw=math.cos(yaw); local sinYaw=math.sin(yaw)
			mapRelative=Vector2.new(mapRelative.X*cosYaw - mapRelative.Y*sinYaw, mapRelative.X*sinYaw + mapRelative.Y*cosYaw)
		end
		local scaled=Vector2.new(mapRelative.X/minimapRange, mapRelative.Y/minimapRange)
		local position=center+Vector2.new(math.clamp(scaled.X,-1,1), math.clamp(scaled.Y,-1,1))*radius
		local displayPosition=position
		if minimapSmooth then
			local cached=minimapDotPositions[entry.Player] or position
			displayPosition=cached+(position-cached)*math.clamp(minimapSmoothFactor,0.05,1)
		end
		minimapDotPositions[entry.Player]=displayPosition
		dot.Position=UDim2.fromOffset(displayPosition.X, displayPosition.Y)
		dot.Visible=true; visibleCount+=1
		if math.abs(relative.Y)>minimapRange*0.2 then dot.BackgroundColor3=Color3.fromRGB(90,170,255)
		elseif planarDistance<minimapRange*0.25 then dot.BackgroundColor3=Color3.fromRGB(85,255,135)
		elseif planarDistance<minimapRange*0.65 then dot.BackgroundColor3=Color3.fromRGB(255,220,90)
		else dot.BackgroundColor3=Color3.fromRGB(255,90,90) end
		local label=dot:FindFirstChild("Label")
		if label and label:IsA("TextLabel") then
			label.Visible=minimapShowNames
			if minimapShowHeight then label.Text=string.format("%s %.1fM Y%+.0f", entry.Player.Name, planarDistance/1000000, relative.Y)
			else label.Text=string.format("%s %.1fM", entry.Player.Name, planarDistance/1000000) end
		end
	end
	for trackedPlayer, dot in pairs(minimapDots) do
		if not seen[trackedPlayer] then dot:Destroy(); minimapDots[trackedPlayer]=nil; minimapDotPositions[trackedPlayer]=nil end
	end
	minimapVisibleCount=visibleCount; minimapTrackedCount=#entries
	minimapNearestText=nearestName and string.format("Nearest: %s %.1fM studs", nearestName, nearestDistance/1000000) or "Nearest: none"
	minimapStatus.Text=string.format("Auto range: %.1fM studs | Visible: %d", minimapRange/1000000, visibleCount)
end

