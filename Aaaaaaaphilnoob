		if running then startTeleport() else stopTeleport() end
	elseif input.KeyCode == Enum.KeyCode.R then
		riotRunning = not riotRunning
		setToggleByIndex("SpinMotion", riotRunning)
		if riotRunning then startRiot() else stopRiot() end
	elseif input.KeyCode == MenuKey then
		Visible = not Visible; MainFrame.Visible = Visible
	end
end)

Library:Notify("Ascida loaded.", "success")
