function updateUI()
	if isOrbiting then
		toggleButton.BackgroundColor3 = Color3.fromRGB(40,150,70)
		toggleButton.Text = "stop orbit"
		statusText.Text = "status: orbiting 2.1B studs at insane speed (fast!)"
	else
		toggleButton.BackgroundColor3 = Color3.fromRGB(150,40,40)
		toggleButton.Text = "start orbit"
		statusText.Text = "status: idle"
	end
end

