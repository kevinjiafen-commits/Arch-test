-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- Character
local character
local humanoidRootPart
local humanoid

-- Orbit settings
local isOrbiting = false
local orbitConnection = nil
local orbitAngle = 0
local orbitSpeed = 500
local orbitRadius = 2_147_483_648
local orbitCenter = Vector3.new(0, 50, 0)

-- Mute sounds
local function muteCharacterSounds(char)
	for _,v in pairs(char:GetDescendants()) do
		if v:IsA("Sound") then
			v.Volume = 0
			v:Stop()
		end
	end
end

local function onDescendantAdded(desc)
	if desc:IsA("Sound") then
		desc.Volume = 0
		desc:Stop()
	end
end

-- Setup character
local function setupCharacter(char)
	character = char
	humanoidRootPart = char:WaitForChild("HumanoidRootPart")
	humanoid = char:WaitForChild("Humanoid")

	muteCharacterSounds(char)
	character.DescendantAdded:Connect(onDescendantAdded)

	humanoidRootPart.Anchored = true
	humanoid.PlatformStand = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0

	if isOrbiting then
		if orbitConnection then orbitConnection:Disconnect() end
		orbitAngle = 0
		orbitConnection = RunService.Heartbeat:Connect(function(dt)
			if not humanoidRootPart then return end
			orbitAngle += orbitSpeed * dt
			local x = orbitCenter.X + math.cos(orbitAngle) * orbitRadius
			local z = orbitCenter.Z + math.sin(orbitAngle) * orbitRadius
			humanoidRootPart.CFrame = CFrame.new(x, orbitCenter.Y, z)
		end)
	end
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then
	setupCharacter(player.Character)
end

-- Orbit control
local function startOrbit()
	if not humanoidRootPart then return end
	if orbitConnection then orbitConnection:Disconnect() end
	orbitAngle = 0
	orbitConnection = RunService.Heartbeat:Connect(function(dt)
		if not humanoidRootPart then return end
		orbitAngle += orbitSpeed * dt
		local x = orbitCenter.X + math.cos(orbitAngle) * orbitRadius
		local z = orbitCenter.Z + math.sin(orbitAngle) * orbitRadius
		humanoidRootPart.CFrame = CFrame.new(x, orbitCenter.Y, z)
	end)
end

local function stopOrbit()
	if orbitConnection then
		orbitConnection:Disconnect()
		orbitConnection = nil
	end

	if humanoidRootPart and humanoid then
		humanoidRootPart.Anchored = false
		humanoid.PlatformStand = false
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
	end
end

local function toggleOrbit()
	isOrbiting = not isOrbiting
	if isOrbiting then
		startOrbit()
	else
		stopOrbit()
	end
	updateUI()
end

