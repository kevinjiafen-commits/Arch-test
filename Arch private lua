    Void.settings.rand_vel_x = flags["Slider_VoidRandVelX"] and flags["Slider_VoidRandVelX"].Value or 0
    Void.settings.rand_vel_y = flags["Slider_VoidRandVelY"] and flags["Slider_VoidRandVelY"].Value or 0
    Void.settings.rand_vel_z = flags["Slider_VoidRandVelZ"] and flags["Slider_VoidRandVelZ"].Value or 0
    Void.settings.jerk_intensity = flags["Slider_VoidJerkIntensity"] and flags["Slider_VoidJerkIntensity"].Value or 20
    Void.settings.random_vel_intensity = flags["Slider_VoidRandIntensity"] and flags["Slider_VoidRandIntensity"].Value or 15
    autoPulseVoidEnabled = flags["Toggle_AutoPulseVoid"] and flags["Toggle_AutoPulseVoid"].Value or false
    autoPulseVoidInterval = flags["Slider_AutoPulseInterval"] and flags["Slider_AutoPulseInterval"].Value or 1

    -- Emote
    isEmoteEnabled = flags["Toggle_EmoteEnabled"] and flags["Toggle_EmoteEnabled"].Value or false
    defaultSpeedFactor = flags["Slider_EmoteSpeed"] and flags["Slider_EmoteSpeed"].Value or 1
    isNoodleMode = flags["Toggle_Noodle"] and flags["Toggle_Noodle"].Value or false
    isNeonGlitchMode = flags["Toggle_Neon"] and flags["Toggle_Neon"].Value or false
    isPaperMode = flags["Toggle_Paper"] and flags["Toggle_Paper"].Value or false
    isJitterMode = flags["Toggle_Jitter"] and flags["Toggle_Jitter"].Value or false
    isMeatballMode = flags["Toggle_Meatball"] and flags["Toggle_Meatball"].Value or false
    isGhostMode = flags["Toggle_GhostMode"] and flags["Toggle_GhostMode"].Value or false
    isTrailsMode = flags["Toggle_Trails"] and flags["Toggle_Trails"].Value or false
    isRainbowMode = flags["Toggle_Rainbow"] and flags["Toggle_Rainbow"].Value or false
    isMorphMode = flags["Toggle_Morph"] and flags["Toggle_Morph"].Value or false

    -- Target player
    local targetName = flags["Dropdown_TargetPlayer"] and flags["Dropdown_TargetPlayer"].CurrentOption[1]
    if targetName then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == targetName then
                targetPlayer = p
                break
            end
        end
    end

    -- Start/stop based on state
    if Void.settings.enable_void then
        startVoid()
        if autoPulseVoidEnabled then
            startAutoPulseVoid()
        end
    else
        stopVoid()
        if autoPulseVoidEnabled then
            stopAutoPulseVoid()
        end
    end

    -- Emote
    local packName = flags["Dropdown_EmotePack"] and flags["Dropdown_EmotePack"].CurrentOption[1] or "Cosmic Chaos"
    local emoteName = flags["Dropdown_Emote"] and flags["Dropdown_Emote"].CurrentOption[1] or ""
    if isEmoteEnabled and emoteName ~= "" and emotePacks[packName] then
        for _, e in ipairs(emotePacks[packName]) do
            if e.name == emoteName then
                stopCustomEmote()
                task.wait(0.1)
                playCustomEmote(e.speed, e.style)
                break
            end
        end
    else
        stopCustomEmote()
    end

    -- Flight state
    if cframeFlightEnabled and humanoid then
        humanoid.PlatformStand = true
    elseif not cframeFlightEnabled and humanoid then
        humanoid.PlatformStand = false
    end
    if fakeLagEnabled and hrp then
        hrp.Anchored = false
    end

    applyTheme()
end

-- ============================
-- Auto load config
-- ============================
pcall(function()
    Rayfield:LoadConfiguration()
    syncAllFlags()
end)

Rayfield:Notify({Title = "Loaded", Content = "Arch Lua V3 ready. Save via gear icon.", Duration = 5})

player.CharacterAdded:Connect(function() if targetPlayer == player then stopCustomEmote() end end)
player.CharacterRemoving:Connect(function() if targetPlayer == player then stopCustomEmote() end end)

end) -- pcall end

if not success then
    warn("Arch Lua initialization failed: ", err)
end
