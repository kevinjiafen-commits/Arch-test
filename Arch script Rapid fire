local silentAimHookActive = false
local function setupSilentAimHook()
    if silentAimHookActive then return end
    local playerScripts = LocalPlayer.PlayerScripts
    local gunModule = require(playerScripts.Modules.ItemTypes.Gun)
    local originalStartShooting = gunModule.StartShooting

    gunModule.StartShooting = function(self, ...)
        if silentAimActive then
            local targetPartInstance = nil
            local camPos = Camera.CFrame.Position
            local camDir = Camera.CFrame.LookVector
            local closestAngle = silentFov
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                if p:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
                local char = p.Character
                if char then
                    local part = char:FindFirstChild(silentTargetPart)
                    if part then
                        local toTarget = (part.Position - camPos).Unit
                        local angle = math.acos(math.clamp(camDir:Dot(toTarget), -1, 1))
                        local degrees = math.deg(angle)
                        if degrees <= closestAngle then
                            closestAngle = degrees
                            targetPartInstance = part
                        end
                    end
                end
            end
            if targetPartInstance then
                local oldCamCF = Camera.CFrame
                Camera.CFrame = CFrame.lookAt(camPos, targetPartInstance.Position)
                local results = {originalStartShooting(self, ...)}
                Camera.CFrame = oldCamCF
                return unpack(results)
            end
        end
        return originalStartShooting(self, ...)
    end
    silentAimHookActive = true
end
