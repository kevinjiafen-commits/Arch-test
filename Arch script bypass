local function refreshConfigList()
    local files = listfiles(settingsFolder)
    local names = {}
    for _, file in ipairs(files) do
        if file:sub(-5) == ".json" then
            local name = file:match("([^/\\]+)%.json$")
            if name then table.insert(names, name) end
        end
    end
    return names
end

local configDropdown
local function createOrUpdateDropdown(items)
    if configDropdown then
        configDropdown:Destroy()
    end
    configDropdown = ConfigGroup:Dropdown({
        Name = "Config List",
        Options = #items > 0 and items or {"(无配置)"},
        Default = items[1],
        Callback = function(val)
            _G.SelectedConfig = val
        end
    })
end

createOrUpdateDropdown(refreshConfigList())

local function refreshDropdown()
    local items = refreshConfigList()
    createOrUpdateDropdown(items)
    if #items == 0 then
        _G.SelectedConfig = nil
    else
        _G.SelectedConfig = items[1] or nil
    end
end

