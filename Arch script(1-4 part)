local function curweap()
    local viewModels = workspace:FindFirstChild("ViewModels")
    if not viewModels then return nil end
    local firstPerson = viewModels:FindFirstChild("FirstPerson")
    if not firstPerson then return nil end
    for _, child in ipairs(firstPerson:GetChildren()) do
        local parts = {}
        for part in child.Name:gmatch("[^-]+") do table.insert(parts, part:match("^%s*(.-)%s*$")) end
        if #parts >= 2 then return parts[2] end
    end
    return nil
end

runsvc.Heartbeat:Connect(function(dt)
    if not aaSettings.enabled then return end
    if aaSettings.yawtype == "none" and aaSettings.pitchtype == "none" and aaSettings.angletype == "none" then return end
    if not curweap() then return end
    local char = player.Character
    if not char then return end
    local rootpart = char:FindFirstChild("HumanoidRootPart")
    if not rootpart then return end
    aaState.framecounter = aaState.framecounter + 1
    local currenttime = tick()
    local yaw, pitch, roll = 0, 0, 0
    if aaSettings.yawtype == "jitter" then
        local minangle = math.rad(aaSettings.minangle)
        local maxangle = math.rad(aaSettings.maxangle)
        yaw = aaSettings.randomangle and (math.random() * 2 - 1) * maxangle or (math.random() > 0.5 and minangle or -minangle)
    elseif aaSettings.yawtype == "spinbot" then
        local speed = math.rad(aaSettings.minspeed + math.random()*(aaSettings.maxspeed - aaSettings.minspeed)) / 10
        yaw = (currenttime * speed) % (2 * math.pi)
    elseif aaSettings.yawtype == "static" then
        yaw = math.rad(aaSettings.customangle or aaSettings.minangle)
    elseif aaSettings.yawtype == "180" then
        yaw = aaState.framecounter % 60 < 30 and math.pi or 0
    elseif aaSettings.yawtype == "backwards" then
        yaw = math.pi
    elseif aaSettings.yawtype == "offset" then
        yaw = math.rad(aaSettings.customangle or aaSettings.minangle)
    end
    if aaSettings.pitchtype == "down" then
        pitch = math.rad(90)
    elseif aaSettings.pitchtype == "sky" then
        pitch = math.rad(-90)
    elseif aaSettings.pitchtype == "static" then
        pitch = math.rad(aaSettings.customangle or aaSettings.minangle)
    end
    if aaSettings.angletype == "tilt 45" then
        roll = math.rad(45)
    elseif aaSettings.angletype == "tilt 90" then
        roll = math.rad(90)
    elseif aaSettings.angletype == "upside down" then
        roll = math.pi
    elseif aaSettings.angletype == "custom" then
        roll = math.rad(aaSettings.customangle)
    end
    rootpart.CFrame = rootpart.CFrame * CFrame.Angles(pitch, yaw, roll)
end)

