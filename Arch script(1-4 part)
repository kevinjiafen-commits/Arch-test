        espConnection = runsvc.RenderStepped:Connect(updateESP)
    end
    if archState.aimbotActive then
        if aimbotConnection then aimbotConnection:Disconnect() end
        aimbotConnection = runsvc.RenderStepped:Connect(function()
            if not archState.aimbotActive then return end
            local camPos = camera.CFrame.Position
            local camDir = camera.CFrame.LookVector
            local closestAngle = archState.aimFov
            local targetPart = nil
            for _, p in ipairs(players:GetPlayers()) do
                if p == player or (archState.teamCheckAimbot and not isEnemy(p)) then continue end
                local char = p.Character
                if char then
                    local part = char:FindFirstChild(archState.aimTargetPart)
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if part and hum and hum.Health > 0 then
                        local toTarget = (part.Position - camPos).Unit
                        local angle = math.acos(math.clamp(camDir:Dot(toTarget), -1, 1))
                        local degrees = math.deg(angle)
                        if degrees <= closestAngle then
                            if not archState.wallCheckAimbot or isClearLineOfSight(camPos, part.Position, char) then
                                closestAngle = degrees
                                targetPart = part
                            end
                        end
                    end
                end
            end
            if targetPart then camera.CFrame = CFrame.lookAt(camPos, targetPart.Position) end
        end)
    end
    if archState.voidActive then
        task.wait(0.5)
        local hrp = getHRP()
        if hrp then hrp.CFrame = CFrame.new(0, 3.91e37, 0) end
    end
end)

