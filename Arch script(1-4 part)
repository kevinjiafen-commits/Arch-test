    })
    local inner = Library:Create("Frame", {
        Name = "HitNotifInner", BackgroundColor3 = Library.BackgroundColor, BorderColor3 = Library.OutlineColor,
        BorderMode = Enum.BorderMode.Inset, Position = UDim2.fromOffset(1,1), Size = UDim2.new(1,-2,1,-2),
        BackgroundTransparency = 1, ZIndex = 252, Parent = outer,
    })
