        local __v = __a.Players
        local __r = __a.RunService
        local __rs = __a.ReplicatedStorage
        local __ws = __a.Workspace
        local __lp = __v.LocalPlayer
        local __ps = __lp.PlayerScripts
        local __gun = require(__ps.Modules.ItemTypes.Gun)
        local __util = require(__rs.Modules.Utility)
        local __self = {}
        function __self:__init()
            self.__active = true
            self.__target = nil
            self.__desync = false
            self.__conn1 = nil
            self.__conn2 = nil
            self.__task1 = nil
            self.__oldfunc = nil
            self:__setup()
        end
        function __self:__setup()
            self.__conn1 = __r.Heartbeat:Connect(function()
                if not self.__active then return end
                self.__target = self:__find()
            end)
            local __orig = __gun.StartShooting
            self.__oldfunc = __orig
            __gun.StartShooting = function(o, ...)
                if archState.silentAimActive then return __orig(o, ...) end
                local res = {__orig(o, ...)}
                if not o.ClientFighter or not o.ClientFighter.IsLocalPlayer then return unpack(res) end
                local data = res[3]
                if not data or typeof(data) ~= "table" then return unpack(res) end
                res[4] = true
                local tgt = self.__target
                if not self.__active or not tgt or not tgt.Character then return unpack(res) end
                if not self.__desync or self.__curr ~= tgt then
                    self:__desync_start(tgt)
                    task.wait(0.1)
                end
                if self.__task1 then task.cancel(self.__task1) end
                local head = tgt.Character:FindFirstChild("Head")
                if not head then return unpack(res) end
                local hp = head.Position
                local below = hp - Vector3.new(0, 5, 0)
                local cf = CFrame.lookAt(below, hp)
                data[utf8.char(0)] = __util:EncodeCFrame(CFrame.new(below, hp) * CFrame.Angles(cf:ToOrientation()))
                data[utf8.char(1)] = __util:EncodeCFrame(CFrame.new(hp) * CFrame.Angles(cf:ToOrientation()))
                data[utf8.char(2)] = head
                data[utf8.char(3)] = __util:EncodeCFrame(CFrame.new())
                self.__task1 = task.delay(0.15, function() self:__desync_stop() end)
                return unpack(res)
            end
        end
        function __self:__find()
            local myChar = __lp.Character
            if not myChar then return nil end
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end
            local closest, closestDist = nil, math.huge
            for _, plr in ipairs(__v:GetPlayers()) do
                if plr == __lp or plr:GetAttribute("TeamID") == __lp:GetAttribute("TeamID") then continue end
                local char = plr.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local head = char:FindFirstChild("Head")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if root and head and hum and hum.Health > 0 then
                        local dist = (myRoot.Position - root.Position).Magnitude
                        if dist <= 200 and dist < closestDist then
                            closestDist = dist
                            closest = plr
                        end
                    end
                end
            end
            return closest
        end
        function __self:__desync_start(plr)
            if self.__conn2 then self.__conn2:Disconnect() end
            self.__desync = true
            self.__curr = plr
            self.__conn2 = __r.Heartbeat:Connect(function()
                if not self.__desync then return end
                local hrp = getHRP()
                if not hrp then return end
                local enemyRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if not enemyRoot then self:__desync_stop() return end
                local oldCF = hrp.CFrame
                local oldVel = hrp.Velocity
                local oldRotVel = hrp.RotVelocity
                hrp.CFrame = enemyRoot.CFrame * CFrame.new(0, -5, 0)
                __r:BindToRenderStep("__restore", 101, function()
                    hrp.CFrame = oldCF
                    hrp.Velocity = oldVel
                    hrp.RotVelocity = oldRotVel
                    __r:UnbindFromRenderStep("__restore")
                end)
            end)
        end
        function __self:__desync_stop()
            self.__desync = false
            self.__curr = nil
            if self.__conn2 then self.__conn2:Disconnect() self.__conn2 = nil end
        end
        function __self:Shutdown()
            self.__active = false
            if self.__conn1 then self.__conn1:Disconnect() end
            if self.__conn2 then self.__conn2:Disconnect() end
            if self.__task1 then task.cancel(self.__task1) end
            if self.__oldfunc then __gun.StartShooting = self.__oldfunc end
        end
        return __self
    end
    local obj = _wFunc()
    obj:__init()
    wallbangObject = obj
    print("[Wallbang] Enabled")
end

local function stopWallbang()
    if wallbangObject then
        wallbangObject:Shutdown()
        wallbangObject = nil
        print("[Wallbang] Disabled")
    end
end

-- // ======== 快速射击实现（直接操控模块数据） ========
local originalGunStats = {}
local function initRapidFireItems()
    if not replicatedstorage then return end
    local itemLib = replicatedstorage:FindFirstChild("Modules"):FindFirstChild("ItemLibrary")
    if not itemLib then task.wait(1) return initRapidFireItems() end
    local success, library = pcall(require, itemLib)
    if not success or type(library) ~= "table" then return end
    local items = library.Items
    if not items then return end
    for name, data in pairs(items) do
        if typeof(data) == "table" and not ({["Sniper"]=true,["Crossbow"]=true,["Bow"]=true,["RPG"]=true})[name] then
            local stats = {}
            if data.ShootCooldown ~= nil then stats.ShootCooldown = data.ShootCooldown end
            if data.ShootBurstCooldown ~= nil then stats.ShootBurstCooldown = data.ShootBurstCooldown end
            if data.ShootSpread ~= nil then stats.ShootSpread = data.ShootSpread end
            if data.ShootAccuracy ~= nil then stats.ShootAccuracy = data.ShootAccuracy end
            if data.ShootRecoil ~= nil then stats.ShootRecoil = data.ShootRecoil end
            if next(stats) then originalGunStats[name] = stats end
        end
    end
end
task.spawn(initRapidFireItems)

local function applyRapidFire()
    local items = require(replicatedstorage.Modules.ItemLibrary).Items
    local delaySec = archState.fireDelay / 1000
    for name, data in pairs(items) do
        if typeof(data) == "table" and originalGunStats[name] then
            data.ShootCooldown = delaySec
            if data.ShootBurstCooldown ~= nil then data.ShootBurstCooldown = delaySec end
            data.ShootSpread = 0
            data.ShootAccuracy = 0
            data.ShootRecoil = 0
        end
    end
end

local function restoreRapidFire()
    local items = require(replicatedstorage.Modules.ItemLibrary).Items
    for name, orig in pairs(originalGunStats) do
        local data = items[name]
        if data then
            if orig.ShootCooldown ~= nil then data.ShootCooldown = orig.ShootCooldown end
            if orig.ShootBurstCooldown ~= nil then data.ShootBurstCooldown = orig.ShootBurstCooldown end
            if orig.ShootSpread ~= nil then data.ShootSpread = orig.ShootSpread end
            if orig.ShootAccuracy ~= nil then data.ShootAccuracy = orig.ShootAccuracy end
            if orig.ShootRecoil ~= nil then data.ShootRecoil = orig.ShootRecoil end
        end
    end
end

-- // ======== ESP 绘制 ========
local espLines = {}
local espTexts = {}
local espBoxes = {}

local function clearESP()
    for _, v in pairs(espLines) do if v then v:Remove() end end
    for _, v in pairs(espTexts) do if v then v:Remove() end end
    for _, v in pairs(espBoxes) do if v then v:Remove() end end
    table.clear(espLines)
    table.clear(espTexts)
    table.clear(espBoxes)
end

local function createESPForPlayer()
    local line = Drawing.new("Line")
    line.Visible = false; line.Color = Color3.fromRGB(255,255,255); line.Thickness = 1
    table.insert(espLines, line)

    local nameText = Drawing.new("Text")
    nameText.Visible = false; nameText.Color = Color3.fromRGB(255,255,255); nameText.Size = 14; nameText.Center = true; nameText.Outline = true
    table.insert(espTexts, nameText)

    local distText = Drawing.new("Text")
    distText.Visible = false; distText.Color = Color3.fromRGB(200,200,200); distText.Size = 13; distText.Center = true; distText.Outline = true
    table.insert(espTexts, distText)

    local boxOutline = Drawing.new("Square")
    boxOutline.Visible = false; boxOutline.Color = Color3.fromRGB(0,0,0); boxOutline.Thickness = 3; boxOutline.Filled = false
    table.insert(espBoxes, boxOutline)

    local box = Drawing.new("Square")
    box.Visible = false; box.Color = Color3.fromRGB(255,255,255); box.Thickness = 1; box.Filled = false
    table.insert(espBoxes, box)
end

local function updateESP()
    local myChar = player.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
        for _, v in pairs(espLines) do v.Visible = false end
        for _, v in pairs(espTexts) do v.Visible = false end
        for _, v in pairs(espBoxes) do v.Visible = false end
        return
    end
    local myRoot = myChar.HumanoidRootPart
    local idx = 1
    for _, p in ipairs(players:GetPlayers()) do
        if not isEnemy(p) then continue end
        local char = p.Character
        if not char then idx = idx + 1 continue end
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (head and root and hum and hum.Health > 0) then idx = idx + 1 continue end

        while #espLines < idx do createESPForPlayer() end

        local line = espLines[idx]
        local nameText = espTexts[idx*2-1]
        local distText = espTexts[idx*2]
        local boxOutline = espBoxes[idx*2-1]
        local box = espBoxes[idx*2]

        local headPos, onScreenH = camera:WorldToViewportPoint(head.Position)
        local rootPos, onScreenR = camera:WorldToViewportPoint(root.Position)
        local onScreen = onScreenH or onScreenR

        if onScreen then
            local height = (root.Position - head.Position).Magnitude * 1.8
            local width = height * 0.5
            local boxX = headPos.X - width/2
            local boxY = headPos.Y
            boxOutline.Position = Vector2.new(boxX, boxY)
            boxOutline.Size = Vector2.new(width, height)
            boxOutline.Visible = true
            box.Position = Vector2.new(boxX, boxY)
            box.Size = Vector2.new(width, height)
            box.Visible = true

            local myPos, _ = camera:WorldToViewportPoint(myRoot.Position)
            line.From = Vector2.new(myPos.X, myPos.Y)
            line.To = Vector2.new(headPos.X, headPos.Y + height)
            line.Visible = true

            local dist = math.floor((myRoot.Position - root.Position).Magnitude)
            nameText.Text = p.Name
            nameText.Position = Vector2.new(headPos.X, headPos.Y - 18)
            nameText.Visible = true
            distText.Text = dist .. "m"
            distText.Position = Vector2.new(headPos.X, headPos.Y + height + 2)
            distText.Visible = true

            local health = hum.Health / hum.MaxHealth
            local col = Color3.fromHSV(health * 0.33, 1, 1)
            box.Color = col
            line.Color = col
        else
            line.Visible = false; nameText.Visible = false; distText.Visible = false
            boxOutline.Visible = false; box.Visible = false
        end
        idx = idx + 1
    end

    for i = idx, #espLines do
        espLines[i].Visible = false
        if espTexts[i*2-1] then espTexts[i*2-1].Visible = false end
        if espTexts[i*2] then espTexts[i*2].Visible = false end
        if espBoxes[i*2-1] then espBoxes[i*2-1].Visible = false end
        if espBoxes[i*2] then espBoxes[i*2].Visible = false end
    end
end

