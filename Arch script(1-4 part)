local function formatHitNotifLine(targetName, dmg, bodyPart)
    return string.format("hit %s for %d in the %s", targetName, math.floor(dmg+0.5), bodyPart or "Body")
end

local function pushHitNotification(targetName, dmg, bodyPart)
    if not config.hitNotifications.enabled or dmg <= 0 then return end
    local parts = createHitNotifBox(formatHitNotifLine(targetName, dmg, bodyPart))
    table.insert(hitNotifEntries, 1, parts)
    while #hitNotifEntries > (config.hitNotifications.maxVisible or 8) do
        local entry = table.remove(hitNotifEntries)
        if entry and entry.outer then pcall(function() entry.outer:Destroy() end) end
    end
end

-- 绑定命中检测
local hitNotifHpTrack = {}
players.PlayerAdded:Connect(function(plr)
    if plr == player then return end
    local function bind(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hitNotifHpTrack[plr] = hum.Health
        hum.HealthChanged:Connect(function(newHp)
            local last = hitNotifHpTrack[plr]
            if last and newHp < last - 0.01 then
                if shouldSuppressGameplayOverlays and shouldSuppressGameplayOverlays() then return end
                local bodyPart = ragePerf.hitPartByPlayer[plr] or config.target.hitpart or "Body"
                pushHitNotification(plr.Name, last - newHp, bodyPart)
                ragePerf.lastHitAtByPlayer[plr] = tick()
                if newHp <= 0 then
                    local tryKill = getgenv().InstanceTryKillSound
                    if tryKill then tryKill(plr, last, newHp) end
                end
            end
            hitNotifHpTrack[plr] = newHp
        end)
    end
    if plr.Character then bind(plr.Character) end
    plr.CharacterAdded:Connect(bind)
end)

local hitNotifUpdateConn
hitNotifUpdateConn = runsvc.RenderStepped:Connect(function(dt)
    if not config.hitNotifications.enabled or (shouldSuppressGameplayOverlays and shouldSuppressGameplayOverlays()) then
        if hitNotifRoot then hitNotifRoot.Visible = false end
        return
    end
    hitNotifRoot.Visible = #hitNotifEntries > 0
    local y = 0
    local gap = config.hitNotifications.stackGap or 6
    local now = tick()
    local inDur = config.hitNotifications.animInDuration or 0.52
    local outDur = config.hitNotifications.animOutDuration or 0.38
    local totalDur = config.hitNotifications.duration or 3
    local i = 1
    while i <= #hitNotifEntries do
        local entry = hitNotifEntries[i]
        local age = now - entry.start
        local alpha = 1
        local ox, oy = 0, 0
        if entry.phase == "in" then
            local t = (now - entry.phaseStart) / inDur
            if t >= 1 then entry.phase = "hold"; entry.phaseStart = now; t = 1 end
            alpha = t
            ox = (1 - t) * -52
        elseif entry.phase == "hold" then
            alpha = 1
            if age >= totalDur - outDur then entry.phase = "out"; entry.phaseStart = now end
        else
            local t = (now - entry.phaseStart) / outDur
            if t >= 1 then
                if entry.outer then entry.outer:Destroy() end
                table.remove(hitNotifEntries, i)
                continue
            end
            alpha = 1 - t
            ox = t * -52
        end
        entry.outer.BackgroundTransparency = 1 - alpha
        entry.inner.BackgroundTransparency = 1 - alpha
        entry.label.TextTransparency = 1 - alpha
        entry.outer.Position = UDim2.fromOffset(math.floor(ox + 0.5), y)
        y = y + (entry.outer.Size.Y.Offset or 26) + gap
        i = i + 1
    end
end)

