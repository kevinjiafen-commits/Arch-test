                local maxangle = math.rad(aaSettings.maxangle)
                pitch = aaSettings.randomangle and randInRange(-maxangle, maxangle) or (math.random() > 0.5 and minangle or -minangle)
            elseif aaSettings.pitchtype == "spinbot" then
