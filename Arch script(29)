        local spreadPatched = false
        local function patchGunSpread()
            if spreadPatched then return end
            local playerScripts = LocalPlayer:WaitForChild("PlayerScripts")
            local gunModule = playerScripts:WaitForChild("Modules"):WaitForChild("ItemTypes"):FindFirstChild("Gun")
            if not gunModule then return end
            local success, module = pcall(require, gunModule)
            if not success then return end
            if module.GetSpread then
                local oldGetSpread = module.GetSpread
                module.GetSpread = function(...)
                    if aimbotActive or silentAimActive then
                        return Vector2.new(0, 0)
                    end
                    return oldGetSpread(...)
                end
                spreadPatched = true
                print("[arch script] Gun spread patched")
            end
            local function patchTool(tool)
                if not tool then return end
                pcall(function()
                    local settings = tool:FindFirstChild("Settings") or tool:FindFirstChild("Config") or tool:FindFirstChild("Stats")
                    if settings then
                        for _, child in pairs(settings:GetChildren()) do
                            if string.find(string.lower(child.Name), "spread") or string.find(string.lower(child.Name), "accuracy") or string.find(string.lower(child.Name), "recoil") then
                                if child:IsA("NumberValue") then
                                    child.Value = 0
                                elseif child:IsA("Vector2Value") then
                                    child.Value = Vector2.new(0, 0)
                                end
                            end
                        end
                    end
                end)
            end
            LocalPlayer.CharacterAdded:Connect(function(char)
