-- ================== 辅助函数 ==================
local function isClearLineOfSight(origin, targetPos, character)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
    local ray = workspace:Raycast(origin, (targetPos - origin).Unit * (targetPos - origin).Magnitude, raycastParams)
    return ray == nil or ray.Instance:IsDescendantOf(character)
end

local function getTargetInFOV(fov, targetPartName, wallCheck, teamCheck)
    local camPos = Camera.CFrame.Position
    local camDir = Camera.CFrame.LookVector
    local closestAngle = fov
    local targetPlayer = nil
    local targetPart = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if teamCheck and p:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
        local char = p.Character
        if char then
            local part = char:FindFirstChild(targetPartName)
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if part and hum and hum.Health > 0 then
                local toTarget = (part.Position - camPos).Unit
                local angle = math.acos(math.clamp(camDir:Dot(toTarget), -1, 1))
                local degrees = math.deg(angle)
                if degrees <= closestAngle then
                    if wallCheck then
                        if isClearLineOfSight(camPos, part.Position, char) then
                            closestAngle = degrees
                            targetPlayer = p
                            targetPart = part
                        end
                    else
                        closestAngle = degrees
                        targetPlayer = p
                        targetPart = part
                    end
                end
            end
        end
    end
    return targetPlayer, targetPart
end

local function getClosestEnemy()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closestPlayer = nil
    local closestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player:GetAttribute("TeamID") ~= LocalPlayer:GetAttribute("TeamID") then
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildWhichIsA("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

