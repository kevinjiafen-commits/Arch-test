-- ============== ESP ==============
local MAX_PLAYERS = 50
local espTracers = {}
local espBoxOutlines = {}
local espBoxCorners = {}
local espFilledBoxes = {}
local espHealthBg = {}
local espHealthFg = {}
local espNameTexts = {}
local espDistTexts = {}
local espSkeletonParts = {}

for i = 1, MAX_PLAYERS do
    local tracer = Drawing.new("Line")
    tracer.Visible = false; tracer.Color = Color3.new(1,1,1); tracer.Thickness = 1
    espTracers[i] = tracer

    local outline = Drawing.new("Square")
    outline.Visible = false; outline.Color = Color3.new(1,1,1); outline.Thickness = 1; outline.Filled = false
    espBoxOutlines[i] = outline

    local corners = {}
    for j = 1, 8 do
        local line = Drawing.new("Line")
        line.Visible = false; line.Color = Color3.new(1,1,1); line.Thickness = 2
        corners[j] = line
    end
    espBoxCorners[i] = corners

    local filled = Drawing.new("Square")
    filled.Visible = false; filled.Color = Color3.new(0,0,0); filled.Thickness = 1; filled.Filled = true; filled.Transparency = 0.7
    espFilledBoxes[i] = filled

    local healthBg = Drawing.new("Square")
    healthBg.Visible = false; healthBg.Color = Color3.new(0,0,0); healthBg.Filled = true
    espHealthBg[i] = healthBg

    local healthFg = Drawing.new("Square")
    healthFg.Visible = false; healthFg.Filled = true
    espHealthFg[i] = healthFg

    local nameText = Drawing.new("Text")
    nameText.Visible = false; nameText.Size = 14; nameText.Center = true; nameText.Outline = true; nameText.Color = Color3.new(1,1,1)
    espNameTexts[i] = nameText

    local distText = Drawing.new("Text")
    distText.Visible = false; distText.Size = 13; distText.Center = true; distText.Outline = true; distText.Color = Color3.new(0.8,0.8,0.8)
    espDistTexts[i] = distText

    local skeleton = {}
    for _, boneName in ipairs({"HeadTorso","LeftArm","RightArm","LeftLeg","RightLeg"}) do
        local boneLine = Drawing.new("Line")
        boneLine.Visible = false; boneLine.Color = Color3.new(1,1,1); boneLine.Thickness = 1
        skeleton[boneName] = boneLine
    end
    espSkeletonParts[i] = skeleton
end

local function getBonePos(character, boneName)
    local part = character:FindFirstChild(boneName)
    return part and part.Position
end

local function drawSkeletonForIndex(idx, character, color)
    local bones = espSkeletonParts[idx]
    local head = getBonePos(character, "Head")
    local torso = getBonePos(character, "UpperTorso") or getBonePos(character, "Torso")
    local lUpperArm = getBonePos(character, "LeftUpperArm") or getBonePos(character, "Left Arm")
    local lHand = getBonePos(character, "LeftHand")
    local rUpperArm = getBonePos(character, "RightUpperArm") or getBonePos(character, "Right Arm")
    local rHand = getBonePos(character, "RightHand")
    local lUpperLeg = getBonePos(character, "LeftUpperLeg") or getBonePos(character, "Left Leg")
    local lFoot = getBonePos(character, "LeftFoot")
    local rUpperLeg = getBonePos(character, "RightUpperLeg") or getBonePos(character, "Right Leg")
    local rFoot = getBonePos(character, "RightFoot")

    local function setLine(key, fromPos, toPos)
        local line = bones[key]
        if line and fromPos and toPos then
            local from, fromVis = workspace.CurrentCamera:WorldToViewportPoint(fromPos)
            local to, toVis = workspace.CurrentCamera:WorldToViewportPoint(toPos)
            line.From = Vector2.new(from.X, from.Y)
            line.To = Vector2.new(to.X, to.Y)
            line.Visible = fromVis or toVis
            line.Color = color
        else
            if line then line.Visible = false end
        end
    end

    setLine("HeadTorso", head, torso)
    setLine("LeftArm", lUpperArm, lHand)
    setLine("RightArm", rUpperArm, rHand)
    setLine("LeftLeg", lUpperLeg, lFoot)
    setLine("RightLeg", rUpperLeg, rFoot)
end

local function clearAllESP()
    for i = 1, MAX_PLAYERS do
        espTracers[i].Visible = false
        espBoxOutlines[i].Visible = false
        espFilledBoxes[i].Visible = false
        espHealthBg[i].Visible = false
        espHealthFg[i].Visible = false
        espNameTexts[i].Visible = false
        espDistTexts[i].Visible = false
        for _, line in pairs(espBoxCorners[i]) do
            line.Visible = false
        end
        for _, line in pairs(espSkeletonParts[i]) do
            line.Visible = false
        end
    end
end

local function updateESP()
    local myChar = LocalPlayer.Character
    if not myChar then
        clearAllESP()
        return
    end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        clearAllESP()
        return
    end

    local cam = workspace.CurrentCamera
    local myRootPos = myRoot.Position

    -- 收集敵人，使用 S.teamCheck 開關決定是否過濾同隊
    local enemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if S.teamCheck then
            local myTeam = LocalPlayer:GetAttribute("TeamID")
            local theirTeam = player:GetAttribute("TeamID")
            if myTeam and theirTeam and myTeam == theirTeam then continue end
        end
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and head and hum and hum.Health > 0 then
                table.insert(enemies, {Player = player, Char = char, Root = root, Head = head, Hum = hum})
            end
        end
    end

    clearAllESP()

    for idx, enemy in ipairs(enemies) do
        if idx > MAX_PLAYERS then break end

        local char = enemy.Char
        local head = enemy.Head
        local root = enemy.Root
        local hum = enemy.Hum

        local headPos, onScreenH = cam:WorldToViewportPoint(head.Position)
        local rootPos, onScreenR = cam:WorldToViewportPoint(root.Position)
        local onScreen = onScreenH or onScreenR
        if not onScreen then continue end

        local height = (root.Position - head.Position).Magnitude * 1.8
        local width = height * 0.5
        local boxX = headPos.X - width/2
        local boxY = headPos.Y
        local health = hum.Health / hum.MaxHealth
        local col = Color3.fromHSV(health * 0.33, 1, 1)

        if S.espShowBox then
            if S.espBoxType == "2D" then
                local out = espBoxOutlines[idx]
                out.Position = Vector2.new(boxX, boxY)
                out.Size = Vector2.new(width, height)
                out.Color = col
                out.Visible = true
            elseif S.espBoxType == "Corner" then
                local cornerLen = width * 0.3
                local corners = espBoxCorners[idx]
                corners[1].From = Vector2.new(boxX, boxY); corners[1].To = Vector2.new(boxX + cornerLen, boxY)
                corners[2].From = Vector2.new(boxX, boxY); corners[2].To = Vector2.new(boxX, boxY + cornerLen)
                corners[3].From = Vector2.new(boxX + width - cornerLen, boxY); corners[3].To = Vector2.new(boxX + width, boxY)
                corners[4].From = Vector2.new(boxX + width, boxY); corners[4].To = Vector2.new(boxX + width, boxY + cornerLen)
                corners[5].From = Vector2.new(boxX, boxY + height - cornerLen); corners[5].To = Vector2.new(boxX, boxY + height)
                corners[6].From = Vector2.new(boxX, boxY + height); corners[6].To = Vector2.new(boxX + cornerLen, boxY + height)
                corners[7].From = Vector2.new(boxX + width - cornerLen, boxY + height); corners[7].To = Vector2.new(boxX + width, boxY + height)
                corners[8].From = Vector2.new(boxX + width, boxY + height - cornerLen); corners[8].To = Vector2.new(boxX + width, boxY + height)
                for _, line in ipairs(corners) do
                    line.Color = col; line.Visible = true
                end
            elseif S.espBoxType == "Filled" then
                local filled = espFilledBoxes[idx]
                filled.Position = Vector2.new(boxX, boxY)
                filled.Size = Vector2.new(width, height)
                filled.Color = Color3.new(0,0,0)
                filled.Visible = true
                local out = espBoxOutlines[idx]
                out.Position = Vector2.new(boxX, boxY)
                out.Size = Vector2.new(width, height)
                out.Color = col
                out.Visible = true
            end
        end

        if S.espShowHealthBar then
            local barWidth = width
            local barHeight = 4
            local barX = boxX; local barY = boxY + height + 4
            espHealthBg[idx].Position = Vector2.new(barX, barY)
            espHealthBg[idx].Size = Vector2.new(barWidth, barHeight)
            espHealthBg[idx].Visible = true
            espHealthFg[idx].Position = Vector2.new(barX, barY)
            espHealthFg[idx].Size = Vector2.new(barWidth * health, barHeight)
            espHealthFg[idx].Color = col
            espHealthFg[idx].Visible = true
        end

        if S.espShowTracers then
            local myPos, _ = cam:WorldToViewportPoint(myRootPos)
            local line = espTracers[idx]
            line.From = Vector2.new(myPos.X, myPos.Y)
            line.To = Vector2.new(headPos.X, headPos.Y + height)
            line.Color = col
            line.Visible = true
        end

        if S.espShowName then
            local txt = espNameTexts[idx]
            txt.Text = enemy.Player.Name
            txt.Position = Vector2.new(headPos.X, boxY - 18)
            txt.Visible = true
        end

        if S.espShowDistance then
            local dist = math.floor((myRootPos - root.Position).Magnitude)
            local txt = espDistTexts[idx]
            txt.Text = dist .. "m"
            txt.Position = Vector2.new(headPos.X, boxY + height + (S.espShowHealthBar and 8 or 4))
            txt.Visible = true
        end

        if S.espShowSkeleton then
            drawSkeletonForIndex(idx, char, col)
        end
    end
end

