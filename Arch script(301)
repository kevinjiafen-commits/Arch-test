    local undergroundEnabled = false

    local function getFloorBelowPosition(pos)
        local rayOrigin = pos
        local rayDirection = Vector3.new(0, -500, 0)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local lf = FighterController and FighterController.LocalFighter
        if lf and lf.Entity and lf.Entity.RootPart then
            raycastParams.FilterDescendantsInstances = {lf.Entity.RootPart.Parent}
        end
        local result = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
        if result then
            local depthOffset = getgenv().InstanceUndergroundDepth or -5
            return CFrame.new(Vector3.new(pos.X, result.Position.Y + depthOffset, pos.Z))
        end
        return nil
    end

    -- 覆蓋 CameraController.Update 防止視角晃動
    if CameraController and CameraController.Update then
        local originalCameraUpdate = CameraController.Update
        CameraController.Update = function(...)
            if undergroundEnabled then
                local lf = FighterController and FighterController.LocalFighter
                if lf and lf.Entity and lf.Entity.RootPart and undergroundOldPos then
                    lf.Entity.RootPart.CFrame = undergroundOldPos
                end
            end
            return originalCameraUpdate(...)
        end
    end

    -- 心跳循環：不斷將玩家傳送到地下
    RunService.Heartbeat:Connect(function()
        if not undergroundEnabled then
            undergroundOldPos = nil
            return
        end

        local weapon = curweap2()
        if not weapon then
            undergroundOldPos = nil
            return
        end

        local lf = FighterController and FighterController.LocalFighter
        if lf and lf.Entity and lf.Entity.RootPart then
            undergroundOldPos = lf.Entity.RootPart.CFrame
            local currentPos = lf.Entity.RootPart.Position
            local floorCFrame = getFloorBelowPosition(currentPos)
            if floorCFrame then
                lf.Entity.RootPart.CFrame = floorCFrame
            end
        end
    end)

    -- 全局控制函數
    getgenv().InstanceSetUnderground = function(val)
        undergroundEnabled = val
        getgenv().InstanceUndergroundEnabled = val
        if not val then
            undergroundOldPos = nil
        end
    end

    getgenv().InstanceUndergroundEnabled = false
end

