function antiaim.calculateyaw(deltatime)
    local yaw = 0
    local cfg = getgenv().AntiAimSettings
    local currenttime = tick()
    if cfg.yawtype == "jitter" then
        local minangle = math.rad(cfg.minangle)
        local maxangle = math.rad(cfg.maxangle)
        if cfg.randomangle then
            yaw = minangle + math.random() * (maxangle - minangle)
            if math.random() > 0.5 then yaw = -yaw end
        else
            yaw = math.random() > 0.5 and minangle or -minangle
        end
    elseif cfg.yawtype == "spinbot" then
        local speed = cfg.minspeed + (cfg.maxspeed - cfg.minspeed) * math.random()
        yaw = (currenttime * (speed / 10)) % (2 * math.pi)
    elseif cfg.yawtype == "random" then
        if statemanager.framecounter % 30 == 0 then
            yaw = math.rad(math.random(-cfg.maxangle, cfg.maxangle))
        else
            yaw = statemanager.smoothyaw
        end
    end
    return yaw
end

function antiaim.calculatepitch()
    local pitch = 0
    local cfg = getgenv().AntiAimSettings
    if cfg.pitchtype == "jitter" then
        local minangle = math.rad(cfg.minangle)
        local maxangle = math.rad(cfg.maxangle)
        if cfg.randomangle then
            pitch = minangle + math.random() * (maxangle - minangle)
            if math.random() > 0.5 then pitch = -pitch end
        else
            pitch = math.random() > 0.5 and minangle or -minangle
        end
    elseif cfg.pitchtype == "spinbot" then
        local speed = cfg.minspeed + (cfg.maxspeed - cfg.minspeed) * math.random()
        pitch = math.sin(tick() * (speed / 10)) * math.rad(cfg.maxangle)
    elseif cfg.pitchtype == "random" then
        if statemanager.framecounter % 20 == 0 then
            pitch = math.rad(math.random(-89, 89))
        else
            pitch = statemanager.smoothpitch
        end
    end
    return pitch
end

function antiaim.calculateroll()
    local roll = 0
    local cfg = getgenv().AntiAimSettings
    if cfg.angletype == "tilt 45" then
        roll = math.rad(45)
    elseif cfg.angletype == "tilt 90" then
        roll = math.rad(90)
    elseif cfg.angletype == "upside down" then
        roll = math.rad(180)
    elseif cfg.angletype == "custom" then
        roll = math.rad(cfg.customangle)
    end
    return roll
end

local function updantiaim(deltatime)
    if not getgenv().AntiAimSettings.enabled then return end
    if getgenv().AntiAimSettings.yawtype == "none" and getgenv().AntiAimSettings.pitchtype == "none" and getgenv().AntiAimSettings.angletype == "none" then
