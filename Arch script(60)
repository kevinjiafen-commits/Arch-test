local function toggleVoid(on)
    S.voidActive = on
    if on then
        local flip = true
        task.spawn(function()
            while S.voidActive do
                local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    if flip then h.CFrame = CFrame.new(0, -1e30, 0) else h.CFrame = CFrame.new(0, 1e30, 0) end
                    flip = not flip
                    h.AssemblyLinearVelocity = Vector3.zero
                    h.AssemblyAngularVelocity = Vector3.zero
                end
                task.wait(0.12)
            end
        end)
    end
end

