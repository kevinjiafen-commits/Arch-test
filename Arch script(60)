local aimbotConn
local function toggleAimbot(on)
    S.aimbotActive = on
    if on then
        aimbotConn = RunService.RenderStepped:Connect(function(dt)
            if not S.aimbotActive then return end
            local targetPart = nil; local camPos = Camera.CFrame.Position; local camDir = Camera.CFrame.LookVector; local closestAngle = S.aimFov
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                if S.teamCheck and not isEnemy(p) then continue end
                local char = p.Character; if not char then continue end
                local part = char:FindFirstChild(S.aimTargetPart); local hum = char:FindFirstChildWhichIsA("Humanoid")
                if part and hum and hum.Health > 0 then
                    local toTarget = (part.Position - camPos).Unit
                    local angle = math.deg(math.acos(math.clamp(camDir:Dot(toTarget), -1, 1)))
                    if angle <= closestAngle then
                        if S.wallCheck then if isClearLineOfSight(camPos, part.Position, char) then closestAngle = angle; targetPart = part end
                        else closestAngle = angle; targetPart = part end
                    end
                end
            end
            if targetPart then
                local targetCF = CFrame.lookAt(camPos, targetPart.Position)
                if S.aimSmooth <= 1 then Camera.CFrame = targetCF
                else Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(1 - math.pow(0.001, dt / S.aimSmooth), 0, 1)) end
            end
        end)
    else if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end end
end

