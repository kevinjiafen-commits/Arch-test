-- Wallbang (保留)
local wallbangObj = nil
do
    local function createWB()
        local svc = setmetatable({},{__index=function(_,s) return cloneref(game:GetService(s)) end})
        local gun = require(LocalPlayer.PlayerScripts.Modules.ItemTypes.Gun)
        local util = require(ReplicatedStorage.Modules.Utility)
        local obj = {}; obj.__active = true; obj.__target = nil; obj.__desync = false
        function obj:__init()
            self.__conn1 = svc.RunService.Heartbeat:Connect(function()
                if not self.__active then return end
                self.__target = self:__find()
            end)
            local oldShoot = gun.StartShooting
            gun.StartShooting = function(slf, ...)
                local res = {oldShoot(slf, ...)}
                if not slf.ClientFighter or not slf.ClientFighter.IsLocalPlayer then return unpack(res) end
                local target = self.__target
                if not self.__active or not target or not target.Character then return unpack(res) end
                if not self.__desync or self.__curr ~= target then
                    self:__desync_start(target); task.wait(0.1)
                end
                local head = target.Character:FindFirstChild("Head")
                if not head then return unpack(res) end
                local hp = head.Position; local below = hp - Vector3.new(0,5,0)
                local cf = CFrame.lookAt(below, hp)
                res[3][utf8.char(0)] = util:EncodeCFrame(CFrame.new(below, hp) * CFrame.Angles(cf:ToOrientation()))
                res[3][utf8.char(1)] = util:EncodeCFrame(CFrame.new(hp) * CFrame.Angles(cf:ToOrientation()))
                res[3][utf8.char(2)] = head
                res[3][utf8.char(3)] = util:EncodeCFrame(CFrame.new())
                task.delay(0.15, function() self:__desync_stop() end)
                return unpack(res)
            end
        end
        function obj:__find()
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end
            local closest, dist = nil, 200
            for _, p in ipairs(svc.Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                if p:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
                local c = p.Character; if not c then continue end
                local r = c:FindFirstChild("HumanoidRootPart"); if not r then continue end
                local d = (myRoot.Position - r.Position).Magnitude
                if d < dist then dist = d; closest = p end
            end
            return closest
        end
        function obj:__desync_start(target)
            if self.__conn2 then self.__conn2:Disconnect() end
            self.__desync = true; self.__curr = target
            self.__conn2 = svc.RunService.Heartbeat:Connect(function()
                if not self.__desync then return end
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                local eRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                if not eRoot then self:__desync_stop(); return end
                local oldCF = myRoot.CFrame; myRoot.CFrame = eRoot.CFrame * CFrame.new(0,-5,0)
                RunService:BindToRenderStep("wb", 101, function()
                    myRoot.CFrame = oldCF; RunService:UnbindFromRenderStep("wb")
                end)
            end)
        end
        function obj:__desync_stop() self.__desync = false; if self.__conn2 then self.__conn2:Disconnect(); self.__conn2 = nil end end
        function obj:Shutdown() self.__active = false; if self.__conn1 then self.__conn1:Disconnect() end; self:__desync_stop() end
        return obj
    end
    function startWallbang() if not wallbangObj then wallbangObj = createWB(); wallbangObj:__init() end end
    function stopWallbang() if wallbangObj then wallbangObj:Shutdown(); wallbangObj = nil end end
end
local function toggleWallbang(on) S.wallbangActive = on; if on then startWallbang() else stopWallbang() end end

