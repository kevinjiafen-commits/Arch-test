function applyGunEnhancements()
    local ok, Gun = pcall(require, LocalPlayer.PlayerScripts.Modules.ItemTypes.Gun)
    if not ok then return end
    if S.instantAdsEnabled then
        Gun.StartAiming = function(self, p) self:SetReplicate("IsAiming", true); self.StopSprinting:Fire(); self.ViewModel:SetAiming(true); self:SetReplicate("FOVOffset", self.Info.AimFOVOffset); if self.ViewModel.CurrentAimValue then self.ViewModel.CurrentAimValue = 1 end; return true, "StartAiming" end
        Gun.GetAimSpeed = function() return 999 end
    else if originalGunFunctions.StartAiming then Gun.StartAiming = originalGunFunctions.StartAiming end; if originalGunFunctions.GetAimSpeed then Gun.GetAimSpeed = originalGunFunctions.GetAimSpeed end end
    if S.noEquipAnimEnabled then
        Gun.Equip = function(self, ...) local r = {originalGunFunctions.Equip(self, ...)}; if self.ViewModel then self.ViewModel:StopAnimation("Equip"); self.ViewModel:StopAnimation("EquipEmpty") end; return unpack(r) end
    elseif originalGunFunctions.Equip then Gun.Equip = originalGunFunctions.Equip end
    if S.silentAimActive or S.noShootAnimEnabled then
        local currentShoot = Gun.StartShooting
        Gun.StartShooting = function(self, ...)
            if S.silentAimActive then
                local targetPart = nil; local camPos = Camera.CFrame.Position; local camDir = Camera.CFrame.LookVector; local closestAngle = S.silentFov
                for _, p in ipairs(Players:GetPlayers()) do
                    if p == LocalPlayer then continue end
                    if p:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
                    local char = p.Character; if not char then continue end
                    local part = char:FindFirstChild(S.silentTargetPart); if not part then continue end
                    local toTarget = (part.Position - camPos).Unit; local angle = math.deg(math.acos(math.clamp(camDir:Dot(toTarget), -1, 1)))
                    if angle <= closestAngle then closestAngle = angle; targetPart = part end
                end
                if targetPart then
                    local oldCF = Camera.CFrame; Camera.CFrame = CFrame.lookAt(camPos, targetPart.Position)
                    local vm = self.ViewModel; local savedPlay
                    if vm and S.noShootAnimEnabled then savedPlay = vm.PlayAnimation; vm.PlayAnimation = function() end end
                    local results = {currentShoot(self, ...)}
                    if vm and savedPlay then vm.PlayAnimation = savedPlay end
                    Camera.CFrame = oldCF
                    if vm and S.noShootAnimEnabled then for _, name in ipairs({"Shoot","Fire","ShootBurst","Shoot_ADS","ShootHip","ShootEmpty"}) do vm:StopAnimation(name) end end
                    return unpack(results)
                end
            end
            if S.noShootAnimEnabled then
                local vm = self.ViewModel; local savedPlay; if vm then savedPlay = vm.PlayAnimation; vm.PlayAnimation = function() end end
                local results = {currentShoot(self, ...)}
                if vm and savedPlay then vm.PlayAnimation = savedPlay; for _, name in ipairs({"Shoot","Fire","ShootBurst","Shoot_ADS","ShootHip","ShootEmpty"}) do vm:StopAnimation(name) end end
                return unpack(results)
            end
            return currentShoot(self, ...)
        end
    end
end

