local function updateESP()
    if not S.espActive then return end
    local myChar = LocalPlayer.Character
    if not myChar then
        for _, pool in ipairs(PlayerPool) do
            pool.Tracer.Visible = false; pool.BoxOutline.Visible = false; pool.BoxFill.Visible = false
            pool.HealthBG.Visible = false; pool.HealthFill.Visible = false
            pool.NameText.Visible = false; pool.DistText.Visible = false
            for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
            for _, l in ipairs(pool.Skeleton) do l.Visible = false end
        end
        return
    end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local idx = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then continue end
        local char = player.Character; if not char then continue end
        local head = char:FindFirstChild("Head"); local root = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not (head and root and hum and hum.Health > 0) then continue end
        idx = idx + 1; if idx > MAX_PLAYERS then break end
        local pool = PlayerPool[idx]
        local headPos, onScreenH = Camera:WorldToViewportPoint(head.Position)
        local rootPos, onScreenR = Camera:WorldToViewportPoint(root.Position)
        local onScreen = onScreenH or onScreenR
        if not onScreen then
            pool.Tracer.Visible = false; pool.BoxOutline.Visible = false; pool.BoxFill.Visible = false
            pool.HealthBG.Visible = false; pool.HealthFill.Visible = false
            pool.NameText.Visible = false; pool.DistText.Visible = false
            for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
            for _, l in ipairs(pool.Skeleton) do l.Visible = false end
            continue
        end
        local health = hum.Health / hum.MaxHealth
        local color = Color3.fromHSV(health * 0.33, 1, 1)
        local height = (root.Position - head.Position).Magnitude * 1.8
        local width = height * 0.5
        local boxX = headPos.X - width/2
        local boxY = headPos.Y
        -- Box
        if S.espShowBox then
            if S.espBoxType == "Filled" then
                pool.BoxFill.Position = Vector2.new(boxX, boxY); pool.BoxFill.Size = Vector2.new(width, height); pool.BoxFill.Visible = true
                pool.BoxOutline.Visible = false; for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
            elseif S.espBoxType == "Corner" then
                local cl = width * 0.3
                pool.CornerTL.From = Vector2.new(boxX, boxY); pool.CornerTL.To = Vector2.new(boxX+cl, boxY); pool.CornerTL.Color = color; pool.CornerTL.Visible = true
                pool.CornerTR.From = Vector2.new(boxX, boxY); pool.CornerTR.To = Vector2.new(boxX, boxY+cl); pool.CornerTR.Color = color; pool.CornerTR.Visible = true
                pool.CornerBL.From = Vector2.new(boxX+width, boxY); pool.CornerBL.To = Vector2.new(boxX+width-cl, boxY); pool.CornerBL.Color = color; pool.CornerBL.Visible = true
                pool.CornerBR.From = Vector2.new(boxX+width, boxY); pool.CornerBR.To = Vector2.new(boxX+width, boxY+cl); pool.CornerBR.Color = color; pool.CornerBR.Visible = true
                pool.BoxOutline.Visible = false; pool.BoxFill.Visible = false
            else
                pool.BoxOutline.Position = Vector2.new(boxX, boxY); pool.BoxOutline.Size = Vector2.new(width, height); pool.BoxOutline.Color = color; pool.BoxOutline.Visible = true
                pool.BoxFill.Visible = false; for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
            end
        else
            pool.BoxOutline.Visible = false; pool.BoxFill.Visible = false
            for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
        end
        -- Health
        if S.espShowHealthBar then
            local bw = width; local bh = 4; local bx = boxX; local by = boxY + height + 4
            pool.HealthBG.Position = Vector2.new(bx, by); pool.HealthBG.Size = Vector2.new(bw, bh); pool.HealthBG.Visible = true
            pool.HealthFill.Position = Vector2.new(bx, by); pool.HealthFill.Size = Vector2.new(bw*health, bh); pool.HealthFill.Color = color; pool.HealthFill.Visible = true
        else pool.HealthBG.Visible = false; pool.HealthFill.Visible = false end
        -- Tracers
        if S.espShowTracers then
            local myPos, _ = Camera:WorldToViewportPoint(myRoot.Position)
            pool.Tracer.From = Vector2.new(myPos.X, myPos.Y); pool.Tracer.To = Vector2.new(headPos.X, headPos.Y+height); pool.Tracer.Color = color; pool.Tracer.Visible = true
        else pool.Tracer.Visible = false end
        -- Name
        if S.espShowName then pool.NameText.Text = player.Name; pool.NameText.Position = Vector2.new(headPos.X, boxY-18); pool.NameText.Visible = true else pool.NameText.Visible = false end
        -- Distance
        if S.espShowDistance then
            local dist = math.floor((myRoot.Position - root.Position).Magnitude)
            pool.DistText.Text = dist.."m"; pool.DistText.Position = Vector2.new(headPos.X, boxY+height+(S.espShowHealthBar and 8 or 4)); pool.DistText.Visible = true
        else pool.DistText.Visible = false end
        -- Skeleton
        if S.espShowSkeleton then
            local bones = CachedBones[player]
            if bones then
                local function drawB(idx, p1, p2)
                    if not (p1 and p2) then pool.Skeleton[idx].Visible = false; return end
                    local v1, _ = Camera:WorldToViewportPoint(p1.Position)
                    local v2, _ = Camera:WorldToViewportPoint(p2.Position)
                    pool.Skeleton[idx].From = Vector2.new(v1.X, v1.Y); pool.Skeleton[idx].To = Vector2.new(v2.X, v2.Y)
                    pool.Skeleton[idx].Color = color; pool.Skeleton[idx].Visible = true
                end
                drawB(1, bones.Head, bones.UpperTorso)
                drawB(2, bones.LeftUpperArm, bones.LeftHand)
                drawB(3, bones.RightUpperArm, bones.RightHand)
                drawB(4, bones.LeftUpperLeg, bones.LeftFoot)
                drawB(5, bones.RightUpperLeg, bones.RightFoot)
            else for _, l in ipairs(pool.Skeleton) do l.Visible = false end end
        else for _, l in ipairs(pool.Skeleton) do l.Visible = false end end
    end
    for i = idx+1, MAX_PLAYERS do
        local pool = PlayerPool[i]
        pool.Tracer.Visible = false; pool.BoxOutline.Visible = false; pool.BoxFill.Visible = false
        pool.HealthBG.Visible = false; pool.HealthFill.Visible = false
        pool.NameText.Visible = false; pool.DistText.Visible = false
        for _, c in ipairs({"CornerTL","CornerTR","CornerBL","CornerBR"}) do pool[c].Visible = false end
        for _, l in ipairs(pool.Skeleton) do l.Visible = false end
    end
end

