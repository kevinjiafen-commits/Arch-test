function Controller:EnsureCharacterController()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        if self._charCtrl then self._charCtrl:Destroy() end
        self._charCtrl = nil
        self._boundRoot = nil
