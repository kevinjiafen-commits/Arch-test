local function requireModuleRB(...)
local args = {...}
local path = args
local target = ReplicatedStorage
for i, name in ipairs(args) do
if type(name) == "string" then
if target then
target = target:FindFirstChild(name)
else
return nil
end
else
return nil
end
end
if target and target:IsA("ModuleScript") then
local ok, result = pcall(require, target)
if ok then return result end
end
return nil
end

