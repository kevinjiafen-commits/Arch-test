end

local function isCategoryEnabled(category)
if category == 'Primary' then return togValue('P8S4T5', true)
elseif category == 'Secondary' then return togValue('P8S4T6', true)
elseif category == 'Melee' then return togValue('P8S4T7', true)
end
return false
end

