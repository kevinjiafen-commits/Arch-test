-- 定义下载函数 (多种方式)
local function http_get_simple(url)
    return game:HttpGet(url)
end

local function http_get_with_cache(url)
    return game:HttpGet(url, true)
end

local function http_get_async(url)
    -- 模拟异步，实际同步
    return game:HttpGet(url)
end

-- 定义加载函数 (多种方式)
local function load_string(content)
    local fn, err = loadstring(content)
    if not fn then
        error("loadstring failed: " .. tostring(err))
    end
    return fn()
end

local function load_with_environment(content, env)
    local fn, err = loadstring(content)
    if not fn then
        error("loadstring failed: " .. tostring(err))
    end
    setfenv(fn, env or getfenv())
    return fn()
end

-- 主加载函数 (含重试)
local function load_remote_advanced(url, max_retries, delay)
    max_retries = max_retries or 3
    delay = delay or 1
    local attempts = 0
    local last_error
    local download_methods = {
        http_get_simple,
        http_get_with_cache,
        http_get_async,
    }

    while attempts < max_retries do
        attempts = attempts + 1
        local success, result = pcall(function()
            -- 尝试多种下载方式
            local content = nil
            for _, method in ipairs(download_methods) do
                local ok, res = pcall(method, url)
                if ok then
                    content = res
                    break
                end
            end
            if not content then
                error("所有下载方式均失败")
            end
            -- 尝试加载
            return load_string(content)
        end)

        if success then
            print("[+] 远程脚本加载成功 (尝试 " .. attempts .. ")")
            return true
        else
            last_error = result
            warn("[-] 加载失败 (尝试 " .. attempts .. "): " .. tostring(result))
            if attempts < max_retries then
                task.wait(delay * attempts)
            end
        end
    end

    error("所有加载尝试均失败。最后一次错误: " .. tostring(last_error))
end

