-- ============================================================
local AntiAimModule = (function()
    local settings = {
        enabled = false,
        yawtype = "none",
        pitchtype = "none",
        customangle = 0,
        minspeed = 10,
        maxspeed = 20,
        minangle = 30,
        maxangle = 60,
        randomangle = false,
    }

    local utils = {
        getrandominrange = function(min, max)
            return min + math.random() * (max - min)
        end
    }

    local antiaim = {}

    function antiaim.calculateyaw(deltatime)
        local yaw = 0
        local currenttime = tick()
        if settings.yawtype == "jitter" then
            local minangle = math.rad(settings.minangle)
            local maxangle = math.rad(settings.maxangle)
            if settings.randomangle then
                yaw = utils.getrandominrange(-maxangle, maxangle)
            else
                yaw = math.random() > 0.5 and minangle or -minangle
            end
        elseif settings.yawtype == "spinbot" then
            local speed = utils.getrandominrange(
                settings.minspeed / 10,
                settings.maxspeed / 10
            )
            yaw = (currenttime * speed) % (2 * math.pi)
        elseif settings.yawtype == "custom" then
            yaw = math.rad(settings.customangle)
        end
        return yaw
    end

    function antiaim.calculatepitch()
        local pitch = 0
        if settings.pitchtype == "up" then
            pitch = math.rad(-89)
        elseif settings.pitchtype == "down" then
            pitch = math.rad(89)
        elseif settings.pitchtype == "zero" then
            pitch = 0
        end
        return pitch
    end

    function antiaim.update(dt)
        if not settings.enabled then return end
        local camera = workspace.CurrentCamera
        if not camera then return end
        local yaw = antiaim.calculateyaw(dt)
        local pitch = antiaim.calculatepitch()
        
        local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
        local controllers = scripts and scripts:FindFirstChild("Controllers")
        local camMod = controllers and controllers:FindFirstChild("CameraController")
        if camMod then
            local ok, camCtrl = pcall(require, camMod)
            if ok and camCtrl and type(camCtrl.SetRotation) == "function" then
                pcall(camCtrl.SetRotation, camCtrl, Vector2.new(pitch, yaw))
                return
            end
        end
        local pos = camera.CFrame.Position
        camera.CFrame = CFrame.new(pos) * CFrame.Angles(pitch, yaw, 0)
    end

    return {
        settings = settings,
        update = antiaim.update
    }
end)()

