function unloadScript()
    print("Unloading script...")
    Library.Unloaded = true
    for name, conn in pairs(connections) do
        pcall(function()
            if name == "Aimbot" then
                RunService:UnbindFromRenderStep("Aimbot")
            elseif type(conn) == "table" and conn.Disconnect then
                conn:Disconnect()
            end
        end)
    end
    connections = {}
    for player in pairs(espBoxes) do cleanupPlayerESP(player) end
    pcall(function() fovCircle:Remove() end)
    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    Workspace.Gravity = 196.2
    if originalCameraType then Player.CameraMode = originalCameraType else Player.CameraMode = Enum.CameraMode.Classic end
    if originalMaxZoom then Player.CameraMaxZoomDistance = originalMaxZoom else Player.CameraMaxZoomDistance = 128 end
    if originalMinZoom then Player.CameraMinZoomDistance = originalMinZoom else Player.CameraMinZoomDistance = 0.5 end
    pcall(function()
        local humanoid = getHumanoid()
        if humanoid then humanoid.WalkSpeed = 16 humanoid.JumpPower = 50 end
    end)
    if speedConn then speedConn:Disconnect() speedConn = nil end
    speedEnabled = false
    if infJumpConnection then infJumpConnection:Disconnect() end
    pcall(function()
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = true
        lighting.Brightness = 1
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
    end)
    UI._ui:Destroy()
    UI:Notify("Script unloaded successfully", "success")
end

