-- ============= FLY SYSTEM (修復版) =============
local flyBodyVelocity = nil
local flyBodyGyro = nil
local flyConn = nil

local function stopFly()
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyBodyGyro then
        flyBodyGyro:Destroy()
        flyBodyGyro = nil
    end
    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.AutoRotate = true   -- 還原自動旋轉
        end
    end
end

local function startFly()
    stopFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    hum.PlatformStand = true
    hum.AutoRotate = false          -- 關閉自動旋轉，防止干擾

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(400000, 400000, 400000)
    flyBodyVelocity.Velocity = Vector3.zero
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    flyBodyGyro.CFrame = root.CFrame      -- 初始保持當前朝向
    flyBodyGyro.Parent = root

    local camera = Workspace.CurrentCamera
    flyConn = RunService.Heartbeat:Connect(function()
        if not flyActive then return end
        local charNow = LocalPlayer.Character
        if not charNow then return end
        local rootNow = charNow:FindFirstChild("HumanoidRootPart")
        local humNow = charNow:FindFirstChildWhichIsA("Humanoid")
        if not rootNow or not humNow then return end

        -- 動態重抓 Body 對象（重生保護）
        local bv = rootNow:FindFirstChild("BodyVelocity")
        local bg = rootNow:FindFirstChild("BodyGyro")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(400000, 400000, 400000)
            bv.Parent = rootNow
        end
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(400000, 400000, 400000)
            bg.Parent = rootNow
        end
        flyBodyVelocity = bv
        flyBodyGyro = bg

        -- 移動方向：完全基於攝像機，不依賴角色朝向
        local moveDir = humNow.MoveDirection
        local cam = camera
        local velocity = Vector3.zero

        if moveDir.Magnitude > 0 then
            local camForward = cam.CFrame.LookVector
            local camRight   = cam.CFrame.RightVector
            local horizontalDir = (camForward * moveDir.Z + camRight * moveDir.X)
            if horizontalDir.Magnitude > 0 then
                velocity = horizontalDir.Unit * flySpeed
            end
        end

        -- 上下控制（跳躍/蹲下）
        if humNow.Jump then
            velocity = velocity + Vector3.new(0, flySpeed, 0)
        end
        if humNow.Sit then
            velocity = velocity - Vector3.new(0, flySpeed, 0)
        end

        bv.Velocity = velocity

        -- 身體朝向：僅在移動時平滑轉向移動方向，靜止時保持原位
        if velocity.Magnitude > 1 then
            local horizontalVel = velocity * Vector3.new(1,0,1)
            if horizontalVel.Magnitude > 0.1 then
                local lookTarget = rootNow.Position + horizontalVel.Unit
                bg.CFrame = CFrame.lookAt(rootNow.Position, lookTarget)
            end
        end
    end)
end

