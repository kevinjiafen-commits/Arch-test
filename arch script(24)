-- ============= SPREAD PATCH =============
local spreadPatched = false
local function patchGunSpread()
    if spreadPatched then return end
    local playerScripts = LocalPlayer:WaitForChild("PlayerScripts")
    local gunModule = playerScripts:WaitForChild("Modules"):WaitForChild("ItemTypes"):FindFirstChild("Gun")
    if not gunModule then return end
    
    local success, module = pcall(require, gunModule)
    if not success then return end
    
    if module.GetSpread then
        local oldGetSpread = module.GetSpread
        module.GetSpread = function(...)
            if aimbotActive or silentAimActive then
                return Vector2.new(0, 0)
            end
            return oldGetSpread(...)
        end
        spreadPatched = true
        print("[arch script] Gun spread patched")
    end
    
    local function patchTool(tool)
        if not tool then return end
        pcall(function()
            local settings = tool:FindFirstChild("Settings") or tool:FindFirstChild("Config") or tool:FindFirstChild("Stats")
            if settings then
                for _, child in pairs(settings:GetChildren()) do
                    if string.find(string.lower(child.Name), "spread") or 
                       string.find(string.lower(child.Name), "accuracy") or
                       string.find(string.lower(child.Name), "recoil") then
                        if child:IsA("NumberValue") then
                            child.Value = 0
                        elseif child:IsA("Vector2Value") then
                            child.Value = Vector2.new(0, 0)
                        end
                    end
                end
            end
        end)
    end
    
    LocalPlayer.CharacterAdded:Connect(function(char)
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                patchTool(child)
            end
        end)
    end)
    
    local currentChar = LocalPlayer.Character
    if currentChar then
        local tool = currentChar:FindFirstChildOfClass("Tool")
        if tool then patchTool(tool) end
    end
end
task.spawn(patchGunSpread)

-- ============= COOLDOWN PATCH =============
local function patchMeleeCooldowns()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local itemLib = modules and modules:FindFirstChild("ItemLibrary")
    if not itemLib then return end
    local success, library = pcall(require, itemLib)
    if not (success and type(library) == "table") then return end
    local items = library.Items or library.Weapons or library.Melee or library.Utilities
    if type(items) ~= "table" then return end
    local meleeCooldowns = {
        "Cooldown", "AttackCooldown", "UseDelay", "SpinCooldown",
        "HeavyAttackCooldown", "AbilityCooldown", "FireCooldown"
    }
    for name, item in pairs(items) do
        if type(item) == "table" then
            local itemName = item.Name or name
            local isMelee = (item.Type == "Melee" or item.Category == "Melee" or (item.Damage and not item.AmmoType))
            if isMelee then
                for _, field in ipairs(meleeCooldowns) do
                    if item[field] ~= nil then item[field] = 0 end
                end
            end
            if string.lower(itemName) == "scythe" then
                if item.DashCooldown ~= nil then item.DashCooldown = 0
                elseif item.AbilityCooldown ~= nil then item.AbilityCooldown = 0 end
                print("[arch script] Scythe dash cooldown removed.")
            end
        end
    end
    print("[arch script] Melee cooldowns patched.")
end
task.spawn(patchMeleeCooldowns)

