local function setupDragClick(button, onClick)
    local inputConn
    local startPos, startBtnPos
    local dragged = false
    button.MouseButton1Down:Connect(function()
        startPos = UserInputService:GetMouseLocation()
        startBtnPos = button.Position
        dragged = false
        inputConn = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = UserInputService:GetMouseLocation() - startPos
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                    dragged = true
                end
                if dragged then
                    button.Position = UDim2.new(
                        startBtnPos.X.Scale, startBtnPos.X.Offset + delta.X,
                        startBtnPos.Y.Scale, startBtnPos.Y.Offset + delta.Y
                    )
                end
            end
        end)
    end)
    button.MouseButton1Up:Connect(function()
        if inputConn then inputConn:Disconnect() inputConn = nil end
        if not dragged then onClick() end
    end)
end

